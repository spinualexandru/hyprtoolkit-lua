prefix=@PREFIX@
includedir=@INCLUDE@
libdir=@LIBDIR@

Name: hyprtoolkit-lua
URL: https://github.com/spinualexandru/hyprtoolkit-lua
Description: Lua 5.4 bindings for Hyprtoolkit
Version: @HYPRTOOLKIT_LUA_VERSION@
Requires: hyprtoolkit, lua5.4
Cflags: -I${includedir}
Libs: -L${libdir} -lhyprtoolkit-lua
